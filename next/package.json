{
  "name": "sonata-next",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "scrape:run": "tsx --env-file=.env.local tools/scraper/index.ts run",
    "scrape:dry": "tsx --env-file=.env.local tools/scraper/index.ts dry",
    "scrape:status": "tsx --env-file=.env.local tools/scraper/index.ts status",
    "scrape:clear": "tsx --env-file=.env.local tools/scraper/index.ts clear"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0",
    "lucide-react": "^1.37.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@10.4.1"
